# =============================================
# LAVISH LATRINES PLATFORM - Environment Config
# =============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── Admin Credentials ─────────────────────────────────────────────────────────
# Set these to configure the owner/admin login.
# Changes take effect on next server restart.
ADMIN_EMAIL=kaden@lavishlatrines.com
ADMIN_PASSWORD=YourSecurePasswordHere

# ── Notification Email ────────────────────────────────────────────────────────
# Every new booking and quote request will be emailed to this address.
ADMIN_NOTIFY_EMAIL=kaden@lavishlatrines.com

# ── Square Payments ───────────────────────────────────────────────────────────
# Get these from https://developer.squareup.com/apps
# For a LIVE account set SQUARE_ENVIRONMENT=production and use Production keys.
# Production App ID starts with "sq0idp-", Access Token starts with "EAAAl".
# Sandbox App ID starts with "sq0idp-" too but the Access Token starts with "EAAAl...sandbox".
# The SDK URL on the frontend automatically switches based on this value.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=your-production-access-token
SQUARE_LOCATION_ID=your-location-id
SQUARE_APP_ID=your-production-app-id

# ── Email (Nodemailer - GoDaddy/Microsoft 365 Outlook) ───────────────────────
# Use your full GoDaddy email address as EMAIL_USER.
# EMAIL_PASS is your regular email account password (not an app password).
# If GoDaddy has switched your account to Microsoft 365, these settings work for both.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=kaden@lavishlatrines.com
EMAIL_PASS=your-email-password
EMAIL_FROM="Lavish Latrines <kaden@lavishlatrines.com>"

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
