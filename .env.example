# =============================================
# LAVISH LATRINES PLATFORM - Environment Config
# =============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Square Payments
# Get these from https://developer.squareup.com/apps
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=sandbox-your-access-token-here
SQUARE_LOCATION_ID=your-location-id-here
SQUARE_APP_ID=sandbox-sq0idb-your-app-id-here

# Email (Nodemailer - Gmail example)
# For Gmail: enable 2FA, then create an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Lavish Latrines <youremail@gmail.com>"

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
